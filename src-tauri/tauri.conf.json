{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lvory",
  "version": "0.2.0",
  "identifier": "com.sxuec.lvory",
  "build": {
    "beforeDevCommand": "npm run dev:webpack",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:webpack",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lvory",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/sing-box"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
